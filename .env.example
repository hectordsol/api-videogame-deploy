# ============================================================
#  Variables de entorno - API Videogames
# ============================================================

# --- Base de datos (Tembo PostgreSQL) ---
# Crea una instancia PostgreSQL en Tembo Cloud: https://tembo.io
# Copia la "Connection String" desde el panel de Tembo.
# Formato: postgresql://usuario:password@host:port/database
DATABASE_URL=postgresql://usuario:password@host.tembo.io:5432/database

# --- Puerto del servidor ---
PORT=3001

# --- RAWG API Key ---
# Obten tu API key en: https://rawg.io/apidocs
API_KEY=tu_rawg_api_key_aqui

# --- CORS (opcional) ---
# URL del frontend autorizado para CORS (actualmente usa "*" por defecto)
CORS_URL=http://localhost:3000
